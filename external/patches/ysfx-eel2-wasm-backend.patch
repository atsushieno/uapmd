--- a/include/ysfx.h	2026-10-15 02:47:23
+++ b/include/ysfx.h	2026-10-15 02:47:37
@@ -262,6 +262,10 @@
 YSFX_API bool ysfx_compile(ysfx_t *fx, uint32_t compileopts);
 // check whether the effect is compiled
 YSFX_API bool ysfx_is_compiled(ysfx_t *fx);
+// translate @block and @sample to WebAssembly where supported; true if both run translated once instantiated
+YSFX_API bool ysfx_wasm_generate(ysfx_t *fx);
+// make the calling thread run the translated @block and @sample; true if both now run translated on it
+YSFX_API bool ysfx_wasm_instantiate(ysfx_t *fx);
 
 // get the block size
 YSFX_API uint32_t ysfx_get_block_size(ysfx_t *fx);
diff -ruN a/sources/ysfx.cpp b/sources/ysfx.cpp
--- a/sources/ysfx.cpp	2026-10-15 02:47:23
+++ b/sources/ysfx.cpp	2026-10-15 02:47:37
@@ -586,6 +586,34 @@
     return fx->code.compiled;
 }
 
+bool ysfx_wasm_generate(ysfx_t *fx)
+{
+#ifdef NSEEL_WASM_BACKEND
+    bool all = true;
+    for (NSEEL_CODEHANDLE code : {fx->code.block.get(), fx->code.sample.get()})
+        if (code && !NSEEL_code_wasm_generate(code))
+            all = false;
+    return all;
+#else
+    (void)fx;
+    return false;
+#endif
+}
+
+bool ysfx_wasm_instantiate(ysfx_t *fx)
+{
+#ifdef NSEEL_WASM_BACKEND
+    bool all = true;
+    for (NSEEL_CODEHANDLE code : {fx->code.block.get(), fx->code.sample.get()})
+        if (code && !NSEEL_code_wasm_instantiate(code))
+            all = false;
+    return all;
+#else
+    (void)fx;
+    return false;
+#endif
+}
+
 void ysfx_unload_source(ysfx_t *fx)
 {
     fx->source = {};
