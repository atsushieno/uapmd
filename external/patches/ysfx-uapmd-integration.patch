@@ -96,10 +96,21 @@
 }
 
 
+#ifdef YSFX_EXTERNAL_FONT
+// uapmd: the host supplies the font implementation. Returning null is allowed and makes
+// ysfx fall back to LICE's built-in bitmap font, so a host with no font data still draws
+// text rather than nothing.
+LICE_IFont *ysfx_create_external_lice_font();
 static LICE_IFont *LICE_CreateFont()
 {
+  return ysfx_create_external_lice_font();
+}
+#else
+static LICE_IFont *LICE_CreateFont()
+{
   return new LICE_CachedFont();
 }
+#endif
 static void LICE__DestroyFont(LICE_IFont *bm)
