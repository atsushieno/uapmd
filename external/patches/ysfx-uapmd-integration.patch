diff -ruN a/sources/ysfx_uapmd_placeholder.cpp b/sources/ysfx_uapmd_placeholder.cpp
--- a/sources/ysfx_uapmd_placeholder.cpp	1970-01-01 09:00:00
+++ b/sources/ysfx_uapmd_placeholder.cpp	2026-09-18 11:29:14
@@ -0,0 +1,7 @@
+// uapmd: the ysfx library target has no sources of its own -- everything in it comes from
+// the object libraries it links. Ninja and Make are happy to archive those into a static
+// library on their own, but Xcode produces no product at all for a target with no source
+// files, so linking against it fails with a missing libysfx.a. This gives it one.
+namespace {
+    [[maybe_unused]] int ysfx_uapmd_placeholder = 0;
+}
