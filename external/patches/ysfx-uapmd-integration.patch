diff -ruN a/cmake/BuildType.cmake b/cmake/BuildType.cmake
--- a/cmake/BuildType.cmake	2026-09-18 11:10:02
+++ b/cmake/BuildType.cmake	2026-09-18 11:10:02
@@ -13,5 +13,10 @@
 endif()
 
 # Set the possible values of build type for cmake-gui
-set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS "Debug" "Release"
-    "MinSizeRel" "RelWithDebInfo")
+# uapmd: only a single-configuration generator has CMAKE_BUILD_TYPE in the cache. Under
+# Xcode or Visual Studio the block above deliberately leaves it unset, and setting a
+# property on a cache variable that was never created is an error.
+if(NOT CMAKE_CONFIGURATION_TYPES)
+    set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS "Debug" "Release"
+        "MinSizeRel" "RelWithDebInfo")
+endif()
